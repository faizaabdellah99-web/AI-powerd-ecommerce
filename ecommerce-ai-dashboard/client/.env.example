# ─────────────────────────────────────────────────────────────
#  AI Commerce — Client Environment Variables
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── API proxy (already set in package.json for development) ──
# The client proxies /api/* to the server at localhost:5000
# Change this only if your server runs on a different port
REACT_APP_API_URL=http://localhost:5000
