# ─────────────────────────────────────────────────────────────
#  AI Commerce — Server Environment Variables
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/ecommerce_ai
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/ecommerce_ai
MONGODB_URI=mongodb://localhost:27017/ecommerce_ai

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Google Gemini AI  ─────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Used for: product descriptions, demand forecasting, smart pricing,
#           reorder predictions, and AI chat assistant
GEMINI_API_KEY=your_gemini_api_key_here

# ── Client URL (CORS) ─────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── Vendor registration invite code ──────────────────────────
# Vendors must enter this code when registering to get vendor access
VENDOR_INVITE_CODE=VENDOR2025

# ── Python AI Microservice (optional) ────────────────────────
# Only needed if you run the FastAPI visual search service
AI_SERVICE_URL=http://localhost:8001

# ── Cloudinary (optional — for product image uploads) ────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
